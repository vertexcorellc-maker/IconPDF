---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, TOOLS, ADSENSE, LEGAL } from '../site';
import AdSlot from '../components/AdSlot.astro';
import { TOOL_CONTENT } from '../tool-content';

interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  ogImage?: string;
  faq?: FaqItem[];
  /** Keep the page out of search results (e.g. a tool that is temporarily broken). */
  noindex?: boolean;
}
const { title, description, bodyClass, ogImage, faq, noindex } = Astro.props;

const site = Astro.site?.origin ?? 'https://iconpdf.com';
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const canonical = slug ? `${site}/${slug}` : `${site}/`;
const ogImg = new URL(ogImage ?? '/og.jpg', site).href;

const tool = TOOLS.find((t) => t.slug === slug);
const appName = tool ? tool.title : SITE_NAME;
const appDesc = tool ? tool.blurb : description;

// Structured data — auto-derived per page so every tool gets its own schema.
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    legalName: LEGAL.entity,
    email: LEGAL.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: LEGAL.address[0],
      addressLocality: 'Albuquerque',
      addressRegion: 'NM',
      postalCode: '87110',
      addressCountry: 'US',
    },
    url: `${site}/`,
    logo: `${site}/favicon.svg`,
    description: SITE_TAGLINE,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: `${site}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: appName,
    url: canonical,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any (runs in a web browser)',
    browserRequirements: 'Requires a modern web browser with JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: appDesc,
    provider: { '@type': 'Organization', name: SITE_NAME, url: `${site}/` },
  },
];
if (tool) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: tool.title, item: canonical },
    ],
  });
}
// Tool pages: HowTo + FAQPage from the same data ToolCopy renders visibly.
const content = tool ? TOOL_CONTENT[tool.slug] : undefined;
if (content) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `How to ${content.howTo}`,
    totalTime: 'PT1M',
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    tool: { '@type': 'HowToTool', name: `${SITE_NAME} ${tool!.title} (web browser)` },
    step: content.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
      url: `${canonical}#how-to`,
    })),
  });
}
const faqItems = faq && faq.length ? faq : content?.faq;
if (faqItems && faqItems.length) {
  const faq = faqItems;
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved theme before first paint (obsidian dark is the default).
      try {
        var t = localStorage.getItem('iconpdf-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <!-- Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TQ8MFBW4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#050505" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {
      ADSENSE.client && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <script is:inline>
      document.documentElement.classList.add('ready');
    </script>
  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TQ8MFBW4"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <header class="site-header">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="22" height="22" rx="6.5" fill="currentColor" />
          <path d="M8 6.5h5.2L16.5 10v7.5h-8.5z" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M13 6.5V10h3.5" stroke="#fff" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        {SITE_NAME}
      </a>
      <nav aria-label="Primary">
        <a href="/merge-pdf">Merge</a>
        <a href="/compress-pdf">Compress</a>
        <a href="/organize-pdf">Organize</a>
        <a href="/#tools">All tools</a>
      </nav>
      <span
        class="status-pill"
        id="status-pill"
        title="Every tool runs on this device. Your files are never sent to a server."
      >
        <span class="status-dot" aria-hidden="true"></span>
        <span class="hide-sm">Local engine</span>
        <span class="status-sep hide-sm" aria-hidden="true">•</span>
        <span id="local-processed" class="hide-sm" hidden><b id="local-bytes">0 B</b> processed</span>
        <span class="status-sep hide-sm" id="local-sep" aria-hidden="true" hidden>•</span>
        <span><b>0 B</b> uploaded</span>
      </span>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </header>
    <main>
      {
        tool && (
          <a class="crumb mono" href="/#tools">
            ← All tools <span aria-hidden="true">/</span> {tool.title}
          </a>
        )
      }
      <slot />
      <AdSlot name="footer" minHeight={90} format="horizontal" />
    </main>
    {
      tool && (
        <template id="ad-tool-rail">
          <AdSlot name="tool-rail" minHeight={250} format="rectangle" />
        </template>
      )
    }
    <footer class="site-footer">
      <p>Private by design. Your files never leave this device.</p>
      <nav class="footer-links" aria-label="Legal">
        <a href="/about">About &amp; Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/cookies">Cookies</a>
      </nav>
      <p class="mono">© {new Date().getFullYear()} {LEGAL.entity} · {SITE_NAME} is 100% free &amp; local</p>
    </footer>
    <script>
      import '../lib/workspace.ts';
      import '../lib/result.ts';
      import '../lib/handoff-hydrate.ts';
      import { getLocalBytes, fmtBytes } from '../lib/local-stats';

      // Fill every AdSense unit on the page (no-op until ADSENSE.client is set).
      document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(() => {
        try {
          ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
        } catch {
          /* blocked by an ad blocker — layout is unaffected */
        }
      });

      // Theme toggle (persisted).
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#fafafa' : '#050505');
        try {
          localStorage.setItem('iconpdf-theme', next);
        } catch {
          /* private mode */
        }
      });

      // Live status pill: bytes processed on-device this session.
      const paint = (n: number) => {
        if (!n) return;
        document.getElementById('local-bytes')!.textContent = fmtBytes(n);
        document.getElementById('local-processed')!.hidden = false;
        document.getElementById('local-sep')!.hidden = false;
      };
      paint(getLocalBytes());
      window.addEventListener('iconpdf:input', (e) => paint((e as CustomEvent).detail.total));
    </script>
  </body>
</html>
