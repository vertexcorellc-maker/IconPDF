---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolCopy from '../components/ToolCopy.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Organize PDF: Reorder, Rotate & Delete Pages | ${SITE_NAME}`}
  description="Reorder, rotate and delete PDF pages visually in your browser. Free, unlimited and private: your file is never uploaded."
>
  <section class="tool-head">
    <h1>Organize PDF</h1>
    <p class="lede">Your pages, your order. Drag to rearrange, rotate what's sideways, delete what you don't need.</p>
  </section>

  <section class="tool" id="org-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf" hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose a PDF</strong>
      <span>or drag and drop it here</span>
      <span class="drop-hint">One PDF file</span>
    </label>

    <div class="stage" id="stage" hidden>
      <div class="busy" id="busy" hidden>
        <div class="busy-box"><p id="status">Loading pages…</p></div>
      </div>
      <div class="page-grid" id="grid"></div>
      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="reset">New file</button>
          <button type="button" class="btn btn-primary" id="apply">Apply &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <AdSlot name="tool-inline" minHeight={250} />

  <ToolCopy />

  <script>
    import '../tools/organize/ui.ts';
  </script>
</Base>
