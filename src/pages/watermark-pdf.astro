---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Add a Watermark to a PDF Free, No Upload | ${SITE_NAME}`}
  description="Stamp text over every page of a PDF in your browser. Choose size, colour, opacity and angle. Free, unlimited and private: nothing is uploaded."
>
  <section class="tool-head">
    <h1>Watermark PDF</h1>
    <p class="lede">Mark every page as yours. Stamp DRAFT, CONFIDENTIAL or your name — any size, angle or colour.</p>
  </section>

  <section class="tool" id="wm-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf" hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose a PDF</strong>
      <span>or drag and drop it here</span>
      <span class="drop-hint">One PDF file</span>
    </label>

    <div class="stage" id="stage" hidden>
      <div class="wm-layout">
        <div class="wm-preview" id="preview">
          <img id="prev" alt="First page preview" />
          <div class="wm-text" id="wm"></div>
        </div>
        <div class="wm-controls">
          <label class="opt">Text
            <input type="text" id="text" value="CONFIDENTIAL" maxlength="40" />
          </label>
          <div class="opt-row">
            <label class="opt">Size
              <select id="size">
                <option value="30">Small</option>
                <option value="48" selected>Medium</option>
                <option value="72">Large</option>
              </select>
            </label>
            <label class="opt">Angle
              <select id="angle">
                <option value="45" selected>Diagonal</option>
                <option value="0">Straight</option>
                <option value="-45">Reverse</option>
              </select>
            </label>
            <label class="opt">Layout
              <select id="layout">
                <option value="center" selected>Centre</option>
                <option value="tile">Tiled</option>
              </select>
            </label>
          </div>
          <div class="opt-row">
            <label class="opt">Colour
              <input type="color" id="color" value="#ff0000" />
            </label>
            <label class="opt">Opacity
              <input type="range" id="opacity" min="0.05" max="1" step="0.05" value="0.3" />
            </label>
          </div>
        </div>
      </div>
      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="reset">New file</button>
          <button type="button" class="btn btn-primary" id="apply">Apply &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <section class="copy">
    <h2>How it works</h2>
    <ol>
      <li>Open a PDF and type your watermark text.</li>
      <li>Set the size, colour, opacity and angle. The preview shows page one.</li>
      <li>Click Apply. The watermark is added to every page and downloads.</li>
    </ol>
  </section>

  <script>
    import '../tools/watermark/ui.ts';
  </script>
</Base>
