---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolCopy from '../components/ToolCopy.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Sign a PDF Free, No Upload | ${SITE_NAME}`}
  description="Draw or type your signature and place it on a PDF, right in your browser. Free, unlimited and private: your document is never uploaded."
>
  <section class="tool-head">
    <h1>Sign PDF</h1>
    <p class="lede">Sign without printing a thing. Draw or type your signature, drop it on the page, save.</p>
  </section>

  <section class="tool" id="sign-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf" hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose a PDF</strong>
      <span>or drag and drop it here</span>
      <span class="drop-hint">One PDF file</span>
    </label>

    <div class="stage" id="stage" hidden>
      <div class="sign-layout">
        <div class="sign-page">
          <div class="page-wrap" id="pageWrap">
            <img id="pageImg" alt="PDF page" />
            <div class="sig-overlay" id="sig" hidden>
              <img id="sigImg" alt="Your signature" draggable="false" />
            </div>
          </div>
          <div class="page-nav">
            <button type="button" class="btn btn-small" id="prev">‹ Prev</button>
            <span class="muted" id="pageLabel"></span>
            <button type="button" class="btn btn-small" id="next">Next ›</button>
          </div>
        </div>

        <div class="sign-maker">
          <div class="tabs">
            <button type="button" class="tab is-active" data-tab="draw" id="tabDraw">Draw</button>
            <button type="button" class="tab" data-tab="type" id="tabType">Type</button>
          </div>

          <div class="tab-panel" id="panelDraw">
            <canvas id="pad" width="360" height="150"></canvas>
            <button type="button" class="btn btn-small" id="clearPad">Clear</button>
          </div>

          <div class="tab-panel" id="panelType" hidden>
            <input type="text" id="typed" placeholder="Type your name" maxlength="30" />
          </div>

          <label class="opt">Size on page
            <input type="range" id="sigSize" min="0.1" max="0.6" step="0.02" value="0.3" />
          </label>
          <button type="button" class="btn btn-primary" id="addSig">Place on this page</button>
          <p class="muted sign-hint">After placing, drag the signature to position it.</p>
        </div>
      </div>

      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="reset">New file</button>
          <button type="button" class="btn btn-primary" id="apply" disabled>Apply &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <AdSlot name="tool-inline" minHeight={250} />

  <ToolCopy />

  <script>
    import '../tools/sign/ui.ts';
  </script>
</Base>
