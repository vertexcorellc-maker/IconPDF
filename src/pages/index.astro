    @media (max-width: 480px) {
      .stats {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    import { putHandoff } from '../lib/handoff';

    // --- Drop-first flow: drop a file here, pick an applicable tool, open it loaded ---
    const TOOLS_DATA = JSON.parse(document.getElementById('tools-json')?.textContent || '[]');
    const dropzone = document.getElementById('dropzone');
    const homeFile = document.getElementById('home-file') as HTMLInputElement | null;
    const picker = document.getElementById('picker');
    const pickerGrid = document.getElementById('picker-grid');
    const pickerSub = document.getElementById('picker-sub');
    let droppedFiles: File[] = [];

    const kindOf = (f: File): 'pdf' | 'image' | null =>
      f.type === 'application/pdf' || /\.pdf$/i.test(f.name)
        ? 'pdf'
        : f.type.startsWith('image/') || /\.(jpe?g|png|webp|gif|bmp)$/i.test(f.name)
          ? 'image'
          : null;

    function openPicker(files: File[]) {
      droppedFiles = files;
      const kind = kindOf(files[0]);
      const label = files.length === 1 ? files[0].name : `${files.length} files`;
      if (!kind) {
        if (pickerSub)
          pickerSub.textContent =
            "We can't open that file type yet — IconPDF works with PDFs and images.";
        if (pickerGrid) pickerGrid.innerHTML = '';
      } else {
        const list = TOOLS_DATA.filter((t: any) => t.accepts.includes(kind));
        if (pickerSub) pickerSub.textContent = `${label} · pick a tool`;
        if (pickerGrid)
          pickerGrid.innerHTML = list
            .map(
              (t: any) =>
                `<button class="pk-card" type="button" data-slug="${t.slug}"><span class="pk-tile" style="color:${t.color};background:${t.tint}">${t.icon}</span><span class="pk-name">${t.title}</span></button>`
            )
            .join('');
      }
      picker?.removeAttribute('hidden');
    }
    const closePicker = () => picker?.setAttribute('hidden', '');

    homeFile?.addEventListener('change', () => {
      if (homeFile.files && homeFile.files.length) openPicker(Array.from(homeFile.files));
      homeFile.value = '';
    });
    document.getElementById('browse')?.addEventListener('click', (e) => {
      e.stopPropagation();
      homeFile?.click();
    });
    dropzone?.addEventListener('click', () => homeFile?.click());
    ['dragenter', 'dragover'].forEach((t) =>
      dropzone?.addEventListener(t, (e) => {
        e.preventDefault();
        dropzone.classList.add('is-over');
      })
    );
    ['dragleave', 'drop'].forEach((t) =>
      dropzone?.addEventListener(t, (e) => {
        e.preventDefault();
        dropzone.classList.remove('is-over');
      })
    );
    dropzone?.addEventListener('drop', (e) => {
      const files = (e as DragEvent).dataTransfer?.files;
      if (files && files.length) openPicker(Array.from(files));
    });
    pickerGrid?.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.pk-card') as HTMLElement | null;
      if (!card || !card.dataset.slug) return;
      const slug = card.dataset.slug;
      putHandoff(droppedFiles, slug).then(() => {
        location.href = '/' + slug;
      });
    });
    document.getElementById('picker-close')?.addEventListener('click', closePicker);
    picker?.addEventListener('click', (e) => {
      if (e.target === picker) closePicker();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePicker();
    });

    // --- Tool grid filter + search ---
    const grid = document.getElementById('grid');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    const countEl = document.getElementById('count');
    const emptyEl = document.getElementById('empty');
    const searchEl = document.getElementById('search') as HTMLInputElement | null;
    const pills = Array.from(document.querySelectorAll<HTMLElement>('.pill'));
    let cat = 'all';
    let q = '';

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okCat = cat === 'all' || card.dataset.cat === cat;
        const okQ = !q || (card.dataset.name || '').includes(q);
        const show = okCat && okQ;
        card.hidden = !show;
        if (show) shown++;
      }
      if (countEl) countEl.textContent = String(shown);
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    pills.forEach((pill) =>
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        cat = pill.dataset.cat || 'all';
        apply();
      })
    );
    searchEl?.addEventListener('input', () => {
      q = searchEl.value.trim().toLowerCase();
      apply();
    });
    document.getElementById('reset')?.addEventListener('click', () => {
      cat = 'all';
      q = '';
      if (searchEl) searchEl.value = '';
      pills.forEach((p) => p.classList.toggle('active', p.dataset.cat === 'all'));
      apply();
    });
  </script>
</Base>
