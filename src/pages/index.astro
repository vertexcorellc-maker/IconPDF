---
import Base from '../layouts/Base.astro';
import { SITE_NAME, TOOLS, GROUPS, TOOL_ACCEPTS } from '../site';

const readyCount = TOOLS.filter((t) => t.ready).length;

const GROUP_ICON: Record<string, string> = {
  Organize:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m2 12.5 9.17 4.16a2 2 0 0 0 1.66 0L22 12.5"/><path d="m2 17.5 9.17 4.16a2 2 0 0 0 1.66 0L22 17.5"/></svg>',
  Convert:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>',
  Edit: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>',
  Secure:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.4-7.66 8.95a1 1 0 0 1-.67 0C7.5 20.4 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/></svg>',
  AI: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 14.34 12 20l2.06-5.66L20 12l-5.94-2.34L12 4l-2.06 5.66L4 12Z"/></svg>',
};
const GROUP_LABEL: Record<string, string> = {
  Organize: 'Organize',
  Convert: 'Convert',
  Edit: 'Edit',
  Secure: 'Secure',
  AI: 'AI',
};

const PICKER_TOOLS = TOOLS.filter((t) => t.ready && TOOL_ACCEPTS[t.slug]).map((t) => ({
  slug: t.slug,
  title: t.title,
  accepts: TOOL_ACCEPTS[t.slug],
  icon: GROUP_ICON[t.group],
}));

const FAQS = [
  { q: 'Is IconPDF free?', a: 'Yes — every tool is completely free and unlimited, with no sign-up and no watermarks.' },
  { q: 'Are my files uploaded to a server?', a: 'No. Every tool runs entirely in your browser, so your files are processed on your own device and never leave it.' },
  { q: 'Do I need to create an account?', a: 'No account or sign-up is required. Open a tool and start straight away.' },
  { q: 'Does it work on my phone?', a: 'Yes. IconPDF works in any modern browser on Windows, macOS, Linux, Android and iOS.' },
  { q: 'Is there a file size or number limit?', a: 'No. Because everything is processed on your device, there are no upload size limits.' },
  { q: 'Does IconPDF work offline?', a: 'Once the page has loaded, most tools keep working even without an internet connection.' },
];
const toolItems = TOOLS.filter((t) => t.ready);
---

<Base
  title={`${SITE_NAME}: Every PDF tool, right in your browser`}
  description="Every PDF tool you need, running entirely in your browser. Merge, organize, convert, edit and secure PDFs with no uploads, no sign-up and no limits."
  bodyClass="home"
  faq={FAQS}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Every PDF tool,<br />right in your browser.</h1>
      <p class="sub">
        Free, private and fast. Merge, split, compress, convert and sign your PDFs in a few clicks —
        nothing is ever uploaded.
      </p>

      <div class="dropzone" id="dropzone">
        <input type="file" id="home-file" accept="application/pdf,image/jpeg,image/png,image/webp" multiple hidden />
        <svg class="dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5-5 5 5"/><path d="M12 5v12"/></svg>
        <strong>Drop a PDF or image</strong>
        <span class="dz-or">or <button type="button" class="dz-browse" id="browse">browse files</button></span>
      </div>

      <div class="pills" id="pills">
        <button class="pill active" data-cat="all" type="button">All</button>
        {GROUPS.map((g) => <button class="pill" data-cat={g.toLowerCase()} type="button">{GROUP_LABEL[g]}</button>)}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="tools wrap" id="tools">
    <div class="grid-head">
      <span class="count"><b id="count">{readyCount}</b> tools</span>
      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search" type="text" placeholder="Find a tool" autocomplete="off" />
      </div>
    </div>

    <div class="grid" id="grid">
      {
        TOOLS.map((tool) => {
          const Tag = tool.ready ? 'a' : 'div';
          return (
            <Tag
              class:list={['card', { soon: !tool.ready }]}
              href={tool.ready ? `/${tool.slug}` : undefined}
              data-cat={tool.group.toLowerCase()}
              data-name={`${tool.title} ${tool.blurb}`.toLowerCase()}
            >
              <span class="tile" set:html={GROUP_ICON[tool.group]} />
              <span class="c-body">
                <h3>{tool.title}</h3>
                <p>{tool.blurb}</p>
              </span>
              <span class="c-go">{tool.ready ? '→' : 'Soon'}</span>
            </Tag>
          );
        })
      }
      <div class="empty" id="empty" hidden>
        <p>No tools match your search.</p>
        <button id="reset" type="button">Reset</button>
      </div>
    </div>
  </section>

  <!-- Trust line -->
  <section class="trust">
    <div class="wrap trust-row">
      <span>100% in your browser</span>
      <span>No uploads</span>
      <span>No sign-up</span>
      <span>Works offline</span>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq wrap">
    <h2>Questions</h2>
    <div class="faq-list">
      {
        FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Drop-first picker -->
  <div class="picker" id="picker" hidden>
    <div class="picker-box" role="dialog" aria-modal="true" aria-labelledby="picker-title">
      <button class="picker-x" id="picker-close" type="button" aria-label="Close">✕</button>
      <h2 id="picker-title">Choose a tool</h2>
      <p class="picker-sub" id="picker-sub"></p>
      <div class="picker-grid" id="picker-grid"></div>
    </div>
  </div>

  <script type="application/json" id="tools-json" set:html={JSON.stringify(PICKER_TOOLS)}></script>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: toolItems.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.title,
        url: `https://iconpdf.com/${t.slug}`,
      })),
    })}
  />

  <style is:global>
    body.home { background: #fff; }
    body.home main { max-width: none; margin: 0; padding: 0 0 80px; }
  </style>

  <style>
    .wrap {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Hero */
    .hero {
      padding: 92px 24px 64px;
      text-align: center;
    }
    .hero-inner { max-width: 680px; margin: 0 auto; }
    h1 {
      font-size: clamp(2.3rem, 5.5vw, 3.6rem);
      line-height: 1.06;
      letter-spacing: -0.035em;
      font-weight: 800;
      color: var(--text);
      margin: 0;
      text-wrap: balance;
    }
    .sub {
      margin: 22px auto 0;
      max-width: 36rem;
      font-size: 1.08rem;
      line-height: 1.6;
      color: var(--muted);
    }

    /* Dropzone */
    .dropzone {
      margin: 38px auto 0;
      max-width: 460px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 32px 24px;
      border: 1px dashed #cbd5e1;
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .dropzone:hover,
    .dropzone.is-over {
      border-color: var(--accent);
      background: #f8f9ff;
    }
    .dz-icon { width: 30px; height: 30px; color: var(--accent); }
    .dropzone strong { font-size: 1.05rem; font-weight: 600; color: var(--text); }
    .dz-or { font-size: 0.9rem; color: var(--muted); }
    .dz-browse {
      font: inherit;
      color: var(--accent);
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Filter pills */
    .pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 30px;
    }
    .pill {
      font: inherit;
      font-size: 0.86rem;
      font-weight: 500;
      padding: 7px 16px;
      border-radius: 999px;
      cursor: pointer;
      background: #fff;
      color: var(--muted);
      border: 1px solid var(--line);
      transition: all 0.14s ease;
    }
    .pill:hover { color: var(--text); border-color: #cbd5e1; }
    .pill.active { background: var(--text); color: #fff; border-color: var(--text); }

    /* Tool grid */
    .tools { padding-top: 44px; scroll-margin-top: 70px; }
    .grid-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 20px;
    }
    .count { font-size: 0.9rem; color: var(--muted); }
    .count b { color: var(--text); font-weight: 600; }
    .search { position: relative; width: min(240px, 100%); }
    .search svg {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px;
      height: 15px;
      color: #94a3b8;
    }
    .search input {
      width: 100%;
      font: inherit;
      font-size: 0.9rem;
      padding: 9px 12px 9px 34px;
      border-radius: 10px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--text);
    }
    .search input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(264px, 1fr));
      gap: 12px;
    }
    .card {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #fff;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    a.card:hover { border-color: #c3ccfb; background: #fbfcff; }
    .card.soon { opacity: 0.6; }
    .tile {
      flex: none;
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: #f1f5f9;
      color: #475569;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .tile svg { width: 19px; height: 19px; }
    a.card:hover .tile { background: #eef1ff; color: var(--accent); }
    .c-body { flex: 1; min-width: 0; }
    .c-body h3 { margin: 1px 0 3px; font-size: 1rem; font-weight: 600; color: var(--text); }
    .c-body p { margin: 0; font-size: 0.86rem; line-height: 1.45; color: var(--muted); }
    .c-go {
      flex: none;
      color: #cbd5e1;
      font-size: 1rem;
      transition: transform 0.15s ease, color 0.15s ease;
    }
    a.card:hover .c-go { color: var(--accent); transform: translateX(2px); }
    .card.soon .c-go { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 44px 20px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--muted);
    }
    .empty button {
      margin-top: 8px;
      font: inherit;
      font-weight: 600;
      color: var(--accent);
      background: none;
      border: none;
      cursor: pointer;
    }

    /* Trust line */
    .trust { margin-top: 64px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .trust-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 28px;
      padding: 22px 24px;
      font-size: 0.86rem;
      color: var(--muted);
    }
    .trust-row span { position: relative; }
    .trust-row span:not(:last-child)::after {
      content: '·';
      position: absolute;
      right: -16px;
      color: #cbd5e1;
    }

    /* FAQ */
    .faq { padding: 64px 24px; }
    .faq h2 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text);
      text-align: center;
      margin: 0 0 24px;
    }
    .faq-list { max-width: 680px; margin: 0 auto; }
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 18px 0;
      font-weight: 500;
      color: var(--text);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: '+';
      color: var(--accent);
      font-size: 1.25rem;
      font-weight: 400;
      transition: transform 0.2s ease;
    }
    .faq-item[open] summary::after { transform: rotate(45deg); }
    .faq-item p {
      margin: -6px 0 18px;
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.6;
    }

    /* Picker modal */
    .picker {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15, 23, 42, 0.4);
    }
    .picker[hidden] { display: none; }
    .picker-box {
      position: relative;
      width: min(540px, 100%);
      max-height: 85vh;
      overflow: auto;
      background: #fff;
      border-radius: 16px;
      padding: 28px;
      border: 1px solid var(--line);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.22);
    }
    .picker-x {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 30px;
      height: 30px;
      border: none;
      border-radius: 8px;
      background: #f1f5f9;
      color: var(--muted);
      font-size: 0.9rem;
      cursor: pointer;
    }
    .picker-x:hover { background: #e2e8f0; color: var(--text); }
    .picker-box h2 { font-size: 1.25rem; font-weight: 700; color: var(--text); margin: 0; }
    .picker-sub { margin: 6px 0 20px; font-size: 0.88rem; color: var(--muted); word-break: break-word; }
    .picker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }

    :global(.pk-card) {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: #fff;
      cursor: pointer;
      text-align: left;
      transition: border-color 0.14s ease, background 0.14s ease;
    }
    :global(.pk-card:hover) { border-color: #c3ccfb; background: #fbfcff; }
    :global(.pk-tile) {
      flex: none;
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: #f1f5f9;
      color: #475569;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    :global(.pk-tile svg) { width: 17px; height: 17px; }
    :global(.pk-name) { font-size: 0.92rem; font-weight: 600; color: var(--text); }

    @media (max-width: 520px) {
      .hero { padding-top: 64px; }
    }
  </style>

  <script>
    import { putHandoff } from '../lib/handoff';

    // --- Drop-first flow ---
    const TOOLS_DATA = JSON.parse(document.getElementById('tools-json')?.textContent || '[]');
    const dropzone = document.getElementById('dropzone');
    const homeFile = document.getElementById('home-file') as HTMLInputElement | null;
    const picker = document.getElementById('picker');
    const pickerGrid = document.getElementById('picker-grid');
    const pickerSub = document.getElementById('picker-sub');
    let droppedFiles: File[] = [];

    const kindOf = (f: File): 'pdf' | 'image' | null =>
      f.type === 'application/pdf' || /\.pdf$/i.test(f.name)
        ? 'pdf'
        : f.type.startsWith('image/') || /\.(jpe?g|png|webp|gif|bmp)$/i.test(f.name)
          ? 'image'
          : null;

    function openPicker(files: File[]) {
      droppedFiles = files;
      const kind = kindOf(files[0]);
      const label = files.length === 1 ? files[0].name : `${files.length} files`;
      if (!kind) {
        if (pickerSub)
          pickerSub.textContent = "We can't open that file type yet — IconPDF works with PDFs and images.";
        if (pickerGrid) pickerGrid.innerHTML = '';
      } else {
        const list = TOOLS_DATA.filter((t: any) => t.accepts.includes(kind));
        if (pickerSub) pickerSub.textContent = `${label} · pick a tool`;
        if (pickerGrid)
          pickerGrid.innerHTML = list
            .map(
              (t: any) =>
                `<button class="pk-card" type="button" data-slug="${t.slug}"><span class="pk-tile">${t.icon}</span><span class="pk-name">${t.title}</span></button>`
            )
            .join('');
      }
      picker?.removeAttribute('hidden');
    }
    const closePicker = () => picker?.setAttribute('hidden', '');

    homeFile?.addEventListener('change', () => {
      if (homeFile.files && homeFile.files.length) openPicker(Array.from(homeFile.files));
      homeFile.value = '';
    });
    document.getElementById('browse')?.addEventListener('click', (e) => {
      e.stopPropagation();
      homeFile?.click();
    });
    dropzone?.addEventListener('click', () => homeFile?.click());
    ['dragenter', 'dragover'].forEach((t) =>
      dropzone?.addEventListener(t, (e) => {
        e.preventDefault();
        dropzone.classList.add('is-over');
      })
    );
    ['dragleave', 'drop'].forEach((t) =>
      dropzone?.addEventListener(t, (e) => {
        e.preventDefault();
        dropzone.classList.remove('is-over');
      })
    );
    dropzone?.addEventListener('drop', (e) => {
      const files = (e as DragEvent).dataTransfer?.files;
      if (files && files.length) openPicker(Array.from(files));
    });
    pickerGrid?.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.pk-card') as HTMLElement | null;
      if (!card || !card.dataset.slug) return;
      const slug = card.dataset.slug;
      putHandoff(droppedFiles, slug).then(() => {
        location.href = '/' + slug;
      });
    });
    document.getElementById('picker-close')?.addEventListener('click', closePicker);
    picker?.addEventListener('click', (e) => {
      if (e.target === picker) closePicker();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePicker();
    });

    // --- Tool grid filter + search ---
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    const countEl = document.getElementById('count');
    const emptyEl = document.getElementById('empty');
    const searchEl = document.getElementById('search') as HTMLInputElement | null;
    const pills = Array.from(document.querySelectorAll<HTMLElement>('.pill'));
    let cat = 'all';
    let q = '';

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okCat = cat === 'all' || card.dataset.cat === cat;
        const okQ = !q || (card.dataset.name || '').includes(q);
        const show = okCat && okQ;
        card.hidden = !show;
        if (show) shown++;
      }
      if (countEl) countEl.textContent = String(shown);
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    pills.forEach((pill) =>
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        cat = pill.dataset.cat || 'all';
        apply();
      })
    );
    searchEl?.addEventListener('input', () => {
      q = searchEl.value.trim().toLowerCase();
      apply();
    });
    document.getElementById('reset')?.addEventListener('click', () => {
      cat = 'all';
      q = '';
      if (searchEl) searchEl.value = '';
      pills.forEach((p) => p.classList.toggle('active', p.dataset.cat === 'all'));
      apply();
    });
  </script>
</Base>
