---
import Base from '../layouts/Base.astro';
import { SITE_NAME, TOOLS, GROUPS, TOOL_ACCEPTS } from '../site';

const readyCount = TOOLS.filter((t) => t.ready).length;

const GROUP_META: Record<string, { color: string; tint: string; label: string; icon: string }> = {
  Organize: {
    color: '#4F6DF5',
    tint: 'rgba(79,109,245,0.1)',
    label: 'Organize',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m2 12.5 9.17 4.16a2 2 0 0 0 1.66 0L22 12.5"/><path d="m2 17.5 9.17 4.16a2 2 0 0 0 1.66 0L22 17.5"/></svg>',
  },
  Convert: {
    color: '#0EA5E9',
    tint: 'rgba(14,165,233,0.1)',
    label: 'Convert',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>',
  },
  Edit: {
    color: '#7C3AED',
    tint: 'rgba(124,58,237,0.1)',
    label: 'Edit',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>',
  },
  Secure: {
    color: '#059669',
    tint: 'rgba(5,150,105,0.1)',
    label: 'Edit & Security',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.4-7.66 8.95a1 1 0 0 1-.67 0C7.5 20.4 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/></svg>',
  },
  AI: {
    color: '#D97706',
    tint: 'rgba(217,119,6,0.1)',
    label: 'AI',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 14.34 12 20l2.06-5.66L20 12l-5.94-2.34L12 4l-2.06 5.66L4 12Z"/></svg>',
  },
};

// Ready tools that can receive a dropped file, with their icon/colour — powers the drop-first picker.
const PICKER_TOOLS = TOOLS.filter((t) => t.ready && TOOL_ACCEPTS[t.slug]).map((t) => ({
  slug: t.slug,
  title: t.title,
  accepts: TOOL_ACCEPTS[t.slug],
  color: GROUP_META[t.group].color,
  tint: GROUP_META[t.group].tint,
  icon: GROUP_META[t.group].icon,
}));
---

<Base
  title={`${SITE_NAME}: Every PDF tool, right in your browser`}
  description="Every PDF tool you need, running entirely in your browser. Merge, organize, convert, edit and secure PDFs with no uploads, no sign-up and no limits."
  bodyClass="home"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Every tool you need to work with PDFs, in one place</h1>
      <p class="sub">
        Fast, free, and private. Merge, split, compress, convert, sign and watermark your PDFs in a
        few clicks — everything runs on your device, with nothing to upload.
      </p>

      <div class="dropzone" id="dropzone">
        <input type="file" id="home-file" accept="application/pdf,image/jpeg,image/png,image/webp" multiple hidden />
        <svg class="dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5-5 5 5"/><path d="M12 5v12"/></svg>
        <strong>Drop a PDF or image to start</strong>
        <span class="dz-or">or <button type="button" class="dz-browse" id="browse">browse your files</button></span>
        <span class="dz-hint">We'll show you the tools that fit your file — nothing is uploaded.</span>
      </div>

      <p class="pills-label">or pick a tool</p>
      <div class="pills" id="pills">
        <button class="pill active" data-cat="all">All tools</button>
        {GROUPS.map((g) => <button class="pill" data-cat={g.toLowerCase()}>{GROUP_META[g].label}</button>)}
      </div>
    </div>
  </section>

  <!-- Tool grid -->
  <section class="wrap tools-section">
    <div class="grid-head">
      <div class="count">Showing <span id="count">{readyCount}</span> document tools</div>
      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search" type="text" placeholder="Quick find a tool…" autocomplete="off" />
      </div>
    </div>

    <div class="grid" id="grid">
      {
        TOOLS.map((tool) => {
          const meta = GROUP_META[tool.group];
          const Tag = tool.ready ? 'a' : 'div';
          return (
            <Tag
              class:list={['card', { soon: !tool.ready }]}
              href={tool.ready ? `/${tool.slug}` : undefined}
              data-cat={tool.group.toLowerCase()}
              data-name={`${tool.title} ${tool.blurb}`.toLowerCase()}
            >
              <span class="tile" style={`color:${meta.color};background:${meta.tint}`} set:html={meta.icon} />
              <h3>{tool.title}</h3>
              <p>{tool.blurb}</p>
              <span class="foot">
                {tool.ready ? (
                  <>
                    <span>Open tool</span>
                    <span class="arrow">→</span>
                  </>
                ) : (
                  <span class="soon-tag">Coming soon</span>
                )}
              </span>
            </Tag>
          );
        })
      }
      <div class="empty" id="empty" hidden>
        <p>No tools match your search.</p>
        <button id="reset">Reset filters</button>
      </div>
    </div>
  </section>

  <!-- Value proposition -->
  <section class="value">
    <div class="wrap value-grid">
      <div class="value-copy">
        <span class="kicker">Built for speed &amp; privacy</span>
        <h2>The PDF toolkit that keeps your files on your device</h2>
        <p>
          {SITE_NAME} runs every operation locally in your browser — no bloated desktop installs, no
          accounts, no waiting in an upload queue. Open a tool, drop a file, get your result in
          seconds.
        </p>
        <div class="stats">
          <div class="stat"><div class="num">{readyCount}</div><div class="lab">Free tools, ready to use</div></div>
          <div class="stat"><div class="num">100%</div><div class="lab">Processed on your device</div></div>
          <div class="stat"><div class="num">0</div><div class="lab">Files uploaded to a server</div></div>
        </div>
      </div>

      <div class="value-card">
        <div class="doc-card">
          <div class="doc-top">
            <span class="doc-badge">PDF</span>
            <div class="doc-meta">
              <div class="doc-name">Quarterly_Report.pdf</div>
              <div class="doc-sub">14 pages • 2.4 MB</div>
            </div>
            <span class="verified">On device</span>
          </div>
          <div class="doc-row">
            <span>Processing</span>
            <span class="doc-strong">Local · instant</span>
          </div>
          <div class="bar"><i></i></div>
          <div class="doc-foot">
            <span>Works on Windows, macOS, Linux &amp; mobile</span>
            <a href="/merge-pdf">Try now →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest trust strip -->
  <section class="trust">
    <div class="wrap trust-inner">
      <div class="trust-lead">
        <h3>Private by design</h3>
        <p>Your files never leave your browser. There's nothing to upload and no account to create.</p>
      </div>
      <div class="badges">
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <div><div class="b-t">100% in-browser</div><div class="b-s">No server processing</div></div>
        </div>
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="m9 10 2 2 4-4"/></svg>
          <div><div class="b-t">No uploads, ever</div><div class="b-s">Files stay on your device</div></div>
        </div>
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>
          <div><div class="b-t">No sign-up</div><div class="b-s">Open a tool and go</div></div>
        </div>
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.1 12.7a.8.8 0 0 0 .6 1.3H11l-1 8 8.9-10.7a.8.8 0 0 0-.6-1.3H12l1-8Z"/></svg>
          <div><div class="b-t">Works offline</div><div class="b-s">Fast, even with no network</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Drop-first tool picker (opens after a file is dropped on the home screen) -->
  <div class="picker" id="picker" hidden>
    <div class="picker-box" role="dialog" aria-modal="true" aria-labelledby="picker-title">
      <button class="picker-x" id="picker-close" type="button" aria-label="Close">✕</button>
      <h2 id="picker-title">Choose what to do</h2>
      <p class="picker-sub" id="picker-sub"></p>
      <div class="picker-grid" id="picker-grid"></div>
    </div>
  </div>

  <script type="application/json" id="tools-json" set:html={JSON.stringify(PICKER_TOOLS)}></script>

  <style>
    /* Drop-first dropzone */
    .dropzone {
      margin: 28px auto 0;
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 34px 24px;
      border: 2px dashed #cbd5e1;
      border-radius: 18px;
      background: #fff;
      cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }
    .dropzone:hover,
    .dropzone.is-over {
      border-color: #4f6df5;
      background: #f5f7ff;
      box-shadow: 0 10px 30px -12px rgba(79, 109, 245, 0.35);
    }
    .dz-icon {
      width: 34px;
      height: 34px;
      color: #4f6df5;
      margin-bottom: 4px;
    }
    .dropzone strong {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.12rem;
      color: #0f172a;
    }
    .dz-or { font-size: 0.92rem; color: #64748b; }
    .dz-browse {
      font: inherit;
      font-weight: 600;
      color: #4f6df5;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
    }
    .dz-hint { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }
    .pills-label {
      margin: 24px 0 0;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #94a3b8;
    }

    /* Picker modal */
    .picker {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(2px);
    }
    .picker[hidden] { display: none; }
    .picker-box {
      position: relative;
      width: min(560px, 100%);
      max-height: 85vh;
      overflow: auto;
      background: #fff;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 30px 70px rgba(15, 23, 42, 0.3);
    }
    .picker-x {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 32px;
      height: 32px;
      border: none;
      border-radius: 8px;
      background: #f1f5f9;
      color: #64748b;
      font-size: 0.95rem;
      cursor: pointer;
    }
    .picker-x:hover { background: #e2e8f0; color: #0f172a; }
    .picker-box h2 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 1.3rem;
      color: #0f172a;
      margin: 0;
    }
    .picker-sub {
      margin: 6px 0 20px;
      font-size: 0.9rem;
      color: #64748b;
      word-break: break-word;
    }
    .picker-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }
    /* Picker cards are injected via innerHTML, so these must be global to apply. */
    :global(.pk-card) {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 16px;
      border: 1px solid #e8ecf1;
      border-radius: 14px;
      background: #fff;
      cursor: pointer;
      text-align: left;
      transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    :global(.pk-card:hover) {
      transform: translateY(-2px);
      border-color: #cbd5e1;
      box-shadow: 0 10px 24px -10px rgba(15, 23, 42, 0.15);
    }
    :global(.pk-tile) {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
    }
    :global(.pk-tile svg) { width: 21px; height: 21px; }
    :global(.pk-name) {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 600;
      font-size: 0.98rem;
      color: #0f172a;
    }
  </style>

  <style is:global>
    body.home {
      background: #f4f5f7;
      color: #1e293b;
      font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    body.home main {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    /* Light, sticky header */
    body.home .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
      max-width: none;
      margin: 0;
      padding: 0;
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
    }
    body.home .site-header > * {
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
      padding: 14px 24px;
    }
    body.home .site-header .brand {
      color: #0f172a;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
    }
    body.home .site-header .brand-mark {
      background: #4f6df5;
      box-shadow: 0 2px 8px rgba(79, 109, 245, 0.35);
    }
    body.home .site-header nav a {
      color: #475569;
      font-weight: 600;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    body.home .site-header nav a:hover {
      color: #4f6df5;
    }
    /* Light footer */
    body.home .site-footer {
      max-width: none;
      margin: 0;
      background: #fff;
      border-top: 1px solid #e2e8f0;
      color: #64748b;
    }
  </style>

  <style>
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Hero */
    .hero {
      background: #fff;
      background-image: radial-gradient(#e2e8f0 0.75px, transparent 0.75px);
      background-size: 20px 20px;
      border-bottom: 1px solid #e2e8f0;
      padding: 60px 24px 56px;
    }
    .hero-inner {
      max-width: 780px;
      margin: 0 auto;
      text-align: center;
    }
    h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(1.9rem, 4.6vw, 2.9rem);
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: #0f172a;
      margin: 0;
      text-wrap: balance;
    }
    .sub {
      margin: 18px auto 0;
      max-width: 40rem;
      font-size: clamp(1rem, 1.4vw, 1.12rem);
      line-height: 1.6;
      color: #475569;
    }
    .pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 9px;
      margin-top: 30px;
    }
    .pill {
      font: inherit;
      font-size: 0.86rem;
      font-weight: 600;
      padding: 9px 18px;
      border-radius: 999px;
      cursor: pointer;
      background: #fff;
      color: #475569;
      border: 1px solid #e2e8f0;
      transition: all 0.15s ease;
    }
    .pill:hover {
      border-color: #cbd5e1;
      color: #0f172a;
    }
    .pill.active {
      background: #0f172a;
      color: #fff;
      border-color: #0f172a;
    }

    /* Tool grid */
    .tools-section {
      padding-top: 40px;
      padding-bottom: 48px;
    }
    .grid-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 22px;
    }
    .count {
      font-size: 0.9rem;
      color: #64748b;
      font-weight: 500;
    }
    .count span {
      color: #0f172a;
      font-weight: 700;
    }
    .search {
      position: relative;
      width: min(280px, 100%);
    }
    .search svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      color: #94a3b8;
    }
    .search input {
      width: 100%;
      font: inherit;
      font-size: 0.9rem;
      padding: 10px 12px 10px 36px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #0f172a;
    }
    .search input:focus {
      outline: none;
      border-color: #4f6df5;
      box-shadow: 0 0 0 3px rgba(79, 109, 245, 0.15);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 18px;
    }
    .card {
      display: flex;
      flex-direction: column;
      padding: 24px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid #e8ecf1;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
      text-decoration: none;
      color: inherit;
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease, border-color 0.18s ease;
    }
    a.card:hover {
      transform: translateY(-3px);
      border-color: #cbd5e1;
      box-shadow: 0 12px 28px -8px rgba(15, 23, 42, 0.14);
    }
    a.card:active {
      transform: translateY(-3px) scale(0.99);
    }
    .card.soon {
      opacity: 0.72;
    }
    .tile {
      width: 48px;
      height: 48px;
      border-radius: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      transition: transform 0.18s ease;
    }
    .tile svg {
      width: 24px;
      height: 24px;
    }
    a.card:hover .tile {
      transform: scale(1.06);
    }
    .card h3 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 1.14rem;
      margin: 0 0 7px;
      color: #0f172a;
    }
    a.card:hover h3 {
      color: #4f6df5;
    }
    .card p {
      margin: 0;
      flex: 1;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #64748b;
    }
    .foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #f1f5f9;
      font-size: 0.82rem;
      font-weight: 600;
      color: #94a3b8;
    }
    a.card:hover .foot {
      color: #334155;
    }
    .arrow {
      transition: transform 0.18s ease;
    }
    a.card:hover .arrow {
      transform: translateX(3px);
    }
    .soon-tag {
      color: #94a3b8;
    }
    .card:focus-visible {
      outline: 2px solid #4f6df5;
      outline-offset: 3px;
    }
    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 48px 20px;
      background: #fff;
      border: 1px solid #e8ecf1;
      border-radius: 16px;
      color: #64748b;
    }
    .empty button {
      margin-top: 10px;
      font: inherit;
      font-weight: 600;
      color: #4f6df5;
      background: none;
      border: none;
      cursor: pointer;
    }

    /* Value section */
    .value {
      background: #fff;
      border-top: 1px solid #e2e8f0;
      padding: 64px 0;
    }
    .value-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .kicker {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #475569;
      background: #f1f5f9;
      padding: 6px 12px;
      border-radius: 7px;
    }
    .value-copy h2 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      letter-spacing: -0.02em;
      color: #0f172a;
      margin: 16px 0 12px;
    }
    .value-copy > p {
      color: #475569;
