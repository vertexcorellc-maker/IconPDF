---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Multiple PDF Pages per Sheet (N-up) Free | ${SITE_NAME}`}
  description="Put 2, 4, 6 or 9 PDF pages on a single sheet, right in your browser. Great for handouts and saving paper. Free and private: nothing is uploaded."
>
  <section class="tool-head">
    <h1>Multi-page layout</h1>
    <p class="lede">Fit 2, 4 or more pages on a single sheet. Perfect for handouts, notes and saving paper.</p>
  </section>

  <section class="tool" id="nup-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf" hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose a PDF</strong>
      <span>or drag and drop it here</span>
      <span class="drop-hint">One PDF file</span>
    </label>

    <div class="stage" id="stage" hidden>
      <div class="opt-row">
        <label class="opt">Pages per sheet
          <select id="layout">
            <option value="2">2 per sheet</option>
            <option value="4" selected>4 per sheet</option>
            <option value="6">6 per sheet</option>
            <option value="9">9 per sheet</option>
          </select>
        </label>
        <p class="muted" id="info"></p>
      </div>
      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="reset">New file</button>
          <button type="button" class="btn btn-primary" id="apply">Create &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <AdSlot name="tool-inline" minHeight={250} />

  <section class="copy">
    <h2>How it works</h2>
    <ol>
      <li>Open a PDF and choose how many pages go on each sheet.</li>
      <li>Click Create. Pages are arranged on A4 sheets and the new PDF downloads.</li>
    </ol>
  </section>

  <script>
    import '../tools/nup/ui.ts';
  </script>
</Base>
