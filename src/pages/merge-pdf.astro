---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolCopy from '../components/ToolCopy.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Merge PDF Free, No Upload | ${SITE_NAME}`}
  description="Combine PDF files into one, in any order, right in your browser. Free, unlimited and private: your files are never uploaded."
>
  <section class="tool-head">
    <h1>Merge PDF</h1>
    <p class="lede">Many files in, one PDF out. Drop in PDFs and images, drag them into order, and save.</p>
  </section>

  <section class="tool" id="merge-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf,image/jpeg,image/png" multiple hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose PDF files</strong>
      <span>or drag and drop them here</span>
      <span class="drop-hint">PDFs and JPG/PNG images</span>
    </label>

    <div class="stage" id="stage" hidden>
      <div class="file-list" id="list"></div>

      <label class="add-more" id="addMore">
        <input type="file" id="fileMore" accept="application/pdf,image/jpeg,image/png" multiple hidden />
        ＋ Add more files
      </label>

      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="clear">Clear all</button>
          <button type="button" class="btn btn-primary" id="merge">Merge &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <AdSlot name="tool-inline" minHeight={250} />

  <ToolCopy />

  <script>
    import '../tools/merge/ui.ts';
  </script>
</Base>
