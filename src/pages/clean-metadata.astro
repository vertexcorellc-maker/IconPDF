---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import ToolCopy from '../components/ToolCopy.astro';
import { SITE_NAME } from '../site';
---

<Base
  title={`Remove PDF Metadata Free, No Upload | ${SITE_NAME}`}
  description="Strip hidden metadata — author, software, dates and XMP data — from a PDF before you share it. Runs in your browser; nothing is uploaded."
>
  <section class="tool-head">
    <h1>Clean PDF metadata</h1>
    <p class="lede">See exactly what your PDF says about you — author, software, dates — and wipe it before you hit send.</p>
  </section>

  <section class="tool" id="meta-tool" data-state="idle">
    <label class="drop" id="drop">
      <input type="file" id="file" accept="application/pdf" hidden />
      <span class="drop-icon" aria-hidden="true">＋</span>
      <strong>Choose a PDF</strong>
      <span>or drag and drop it here</span>
      <span class="drop-hint">One PDF file</span>
    </label>

    <div class="stage" id="stage" hidden>
      <h2 class="meta-title">What's hidden in this file</h2>
      <dl class="meta-list" id="meta"></dl>
      <div class="controls">
        <p class="note" id="note"></p>
        <div class="actions">
          <button type="button" class="btn" id="reset">New file</button>
          <button type="button" class="btn btn-primary" id="clean">Remove all &amp; download</button>
        </div>
      </div>
    </div>
  </section>

  <AdSlot name="tool-inline" minHeight={250} />

  <ToolCopy />

  <script>
    import '../tools/metadata/ui.ts';
  </script>
</Base>
